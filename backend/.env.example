ENVIRONMENT=development

# SQLite by default — no database server required. See README.md /
# CONTRIBUTING.md for why, and how this same setting would change to
# point at MySQL/Postgres for a real deployment.
DATABASE_URL=sqlite:///./dev.db

# Generate a real random value for anything beyond local development —
# never commit a real one. Anyone with this value can forge valid tokens.
SECRET_KEY=change-me-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_MINUTES=10080

FAILED_LOGIN_MAX_ATTEMPTS=5
FAILED_LOGIN_LOCKOUT_MINUTES=15

CORS_ORIGINS=["*"]
